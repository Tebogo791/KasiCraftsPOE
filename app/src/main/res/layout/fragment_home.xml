<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_bg"
    android:padding="20dp">

    <!-- Header Section -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/explore_crafts"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:letterSpacing="0.01"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/authentic_african_culture"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:src="@drawable/kasi_crafts_banner"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleImageView"/>
    </RelativeLayout>

    <!-- Search Input Layout -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/search_crafts_hint"
        app:hintTextColor="@color/text_secondary"
        app:boxStrokeColor="@color/accent_orange"
        app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="1.5dp"
        app:boxCornerRadiusTopStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusBottomEnd="16dp"
        app:boxBackgroundColor="@color/card_bg"
        app:startIconDrawable="@android:drawable/ic_menu_search"
        app:startIconTint="@color/text_secondary"
        android:layout_marginBottom="20dp"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:paddingVertical="14dp"
            android:maxLines="1"
            android:inputType="text"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Categories horizontal filter -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="20dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true"
            app:chipSpacingHorizontal="8dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cat_all"
                style="@style/Widget.Material3.Chip.Filter"
                app:chipCornerRadius="12dp"
                app:chipBackgroundColor="@color/accent_orange"
                android:textColor="#FFFFFF"
                app:chipStrokeWidth="0dp"
                android:checked="true"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBaskets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cat_baskets"
                style="@style/Widget.Material3.Chip.Filter"
                app:chipCornerRadius="12dp"
                app:chipBackgroundColor="@color/card_bg"
                android:textColor="@color/text_secondary"
                app:chipStrokeWidth="0dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPottery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cat_pottery"
                style="@style/Widget.Material3.Chip.Filter"
                app:chipCornerRadius="12dp"
                app:chipBackgroundColor="@color/card_bg"
                android:textColor="@color/text_secondary"
                app:chipStrokeWidth="0dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipJewelry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cat_jewelry"
                style="@style/Widget.Material3.Chip.Filter"
                app:chipCornerRadius="12dp"
                app:chipBackgroundColor="@color/card_bg"
                android:textColor="@color/text_secondary"
                app:chipStrokeWidth="0dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTextiles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cat_textiles"
                style="@style/Widget.Material3.Chip.Filter"
                app:chipCornerRadius="12dp"
                app:chipBackgroundColor="@color/card_bg"
                android:textColor="@color/text_secondary"
                app:chipStrokeWidth="0dp"/>
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvProducts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"/>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:indeterminateTint="@color/accent_orange"/>

</LinearLayout>